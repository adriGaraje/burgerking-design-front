# Plantilla de variables de entorno. Copia este fichero a `.env` y rellénalo:
#   cp .env.example .env
# El `.env` real NO se versiona.

# Personal access token de Figma (Settings → Security → Personal access tokens).
# Scopes: file_content:read, file_dev_resources:read
FIGMA_TOKEN=""

# Archivo de Figma de handoff (el de `config.json → figma.files` con `scanned: true`).
# Antes de darlo por bueno, resuelve un nodo conocido contra él.
FIGMA_FILE_KEY=""

# Jira (opcional): solo si `scripts/jira-mirror.mjs` consulta el tablero por REST.
# id.atlassian.com → Security → Create API token
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# Atlassian (npm run check:conexiones; jira-mirror usa JIRA_* con los mismos valores).
# id.atlassian.com → Security → Create API token. El MCP de Claude Code se autoriza aparte (/mcp).
ATLASSIAN_EMAIL=""
ATLASSIAN_API_TOKEN=""

# GitHub (check:conexiones). Claude Code NO lee este fichero:
# el token tiene que estar exportado en el shell que lanza `claude` (export GITHUB_TOKEN=…).
GITHUB_TOKEN=""
